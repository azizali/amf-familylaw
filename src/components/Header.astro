---
import { cta, firmName, navMenu } from '../data/site';
const mark = 'flex size-9 shrink-0 items-center justify-center rounded-xl bg-hi font-serif text-sm font-semibold text-on-hi';
---
<header class="on-deep sticky top-0 z-50 px-3 pt-3 sm:px-5">
  <div class="mx-auto flex h-14 max-w-[72rem] items-center justify-between gap-3 rounded-full border border-deep-line bg-deep/95 pl-2.5 pr-2 text-on-deep shadow-[0_10px_30px_-12px_rgb(0_0_0/0.5)] backdrop-blur">
    <a href="/" class="flex min-w-0 items-center gap-2.5" aria-label={firmName}>
      <span class={mark}>AMF</span>
      <span class="truncate text-[0.8rem] font-semibold leading-tight sm:text-sm">{firmName}</span>
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {navMenu.map((item) => (
        <div class="dd group relative">
          <a href={item.href} class="flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium text-deep-muted transition-colors hover:bg-white/10 hover:text-on-deep group-focus-within:text-on-deep">
            {item.label}
            {item.children && (
              <svg class="size-3.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="rounded-2xl border border-deep-line bg-deep p-2 shadow-[0_24px_50px_-12px_rgb(0_0_0/0.6)]">
                {item.children.map((child) => (
                  <li><a href={child.href} class="block rounded-xl px-3 py-2 text-sm text-deep-muted transition-colors hover:bg-white/10 hover:text-on-deep">{child.label}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      <a href={cta.href} class="btn btn-hi hidden sm:inline-flex">{cta.short}</a>
      <details class="menu lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-deep-line" aria-label="Menu">
          <svg class="menu-open size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
          <svg class="menu-close size-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
        </summary>
        <nav class="fixed inset-x-3 top-[4.75rem] z-50 max-h-[calc(100dvh-6rem)] overflow-y-auto rounded-3xl border border-deep-line bg-deep p-3 shadow-[0_24px_50px_-12px_rgb(0_0_0/0.6)]" aria-label="Mobile">
          {navMenu.map((item) =>
            item.children ? (
              <details class="sub">
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between rounded-2xl px-4 text-lg font-medium hover:bg-white/10">
                  {item.label}
                  <svg class="sub-chev size-4 text-hi transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                </summary>
                <ul class="mb-2 ml-4 border-l border-deep-line pl-2">
                  <li><a href={item.href} class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-hi">All {item.label.toLowerCase()}</a></li>
                  {item.children.map((child) => (
                    <li><a href={child.href} class="block rounded-xl px-3 py-2.5 text-sm text-deep-muted hover:bg-white/10 hover:text-on-deep">{child.label}</a></li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} class="flex min-h-12 items-center justify-between rounded-2xl px-4 text-lg font-medium hover:bg-white/10">
                {item.label}<span class="text-hi" aria-hidden="true">→</span>
              </a>
            )
          )}
          <a href={cta.href} class="btn btn-hi mt-3 w-full">{cta.short}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .menu .menu-close { display: none; }
  .menu[open] .menu-close { display: block; }
  .menu[open] .menu-open { display: none; }
  .menu summary::-webkit-details-marker, .sub summary::-webkit-details-marker { display: none; }
  .sub[open] .sub-chev { transform: rotate(180deg); }
</style>
