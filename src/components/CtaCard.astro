---
import ChatButton from './ChatButton.astro';
import { cta } from '../data/site';
---
<aside class="on-deep r relative overflow-hidden bg-deep p-6 text-on-deep">
  <div class="pointer-events-none absolute -bottom-16 -right-10 size-48 rounded-full opacity-25 blur-3xl" style="background:var(--hi)" aria-hidden="true"></div>
  <div class="relative">
    <h2 class="text-xl leading-snug">Ready to Discuss Your Appeal?</h2>
    <p class="mt-2 text-sm leading-relaxed text-deep-muted">Appellate deadlines are strict and unforgiving. All communications are strictly confidential.</p>
    <a href={cta.href} class="btn btn-hi mt-5 w-full text-center">{cta.label}</a>
    <ChatButton variant="line-deep" class="mt-3 w-full" />
  </div>
</aside>
