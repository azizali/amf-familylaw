---
import { contact } from '../data/site';
---
<section id="get-started" class="py-24 bg-slate-900 border-t border-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <span class="inline-flex w-fit items-center rounded-full border border-slate-700 bg-slate-800 px-3 py-1 mb-6 text-xs font-semibold text-slate-300 transition-colors uppercase tracking-wider">Start Today</span>
    <h2 class="text-3xl sm:text-5xl font-bold text-white mb-6 tracking-tight">Ready to Discuss Your Appeal?</h2>
    <p class="text-xl text-slate-300 font-light mb-10 max-w-2xl mx-auto leading-relaxed">
      Appellate deadlines are strict and unforgiving. Contact my office today to schedule a confidential consultation to review the merits of your case.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 w-full">
      <a href={contact.phone.href} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-14 px-8 text-lg bg-white text-slate-900 hover:bg-slate-100 shadow-sm">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        Call {contact.phone.display}
      </a>
      <a href="mailto:contact@amf-familylaw.com" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 border border-slate-700 disabled:pointer-events-none disabled:opacity-50 h-14 px-8 text-lg bg-transparent text-white hover:bg-slate-800 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        Email My Office
      </a>
    </div>
    
    <p class="mt-8 text-sm text-slate-400 font-light">
      All communications are strictly confidential.
    </p>
  </div>
</section>
