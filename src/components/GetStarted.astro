---
import ChatButton from './ChatButton.astro';
import { cta } from '../data/site';
---
<section id="get-started" class="px-3 pb-3 pt-6 sm:px-5">
  <div class="on-deep wrap relative overflow-hidden rounded-[2rem] bg-deep text-on-deep" data-reveal style="padding:clamp(1.5rem,5vw,3.5rem);max-width:72rem">
    <div class="pointer-events-none absolute -bottom-28 -left-20 size-72 rounded-full opacity-25 blur-3xl" style="background:var(--hi)" aria-hidden="true"></div>
    <div class="relative grid items-end gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="chip" style="background:rgb(255 255 255 / 0.08);color:var(--hi)">Start Today</p>
        <h2 class="mt-4 text-[clamp(1.75rem,3.6vw,2.75rem)] leading-tight">Ready to Discuss Your Appeal?</h2>
        <p class="mt-3 max-w-xl text-deep-muted">
          Appellate deadlines are strict and unforgiving. Contact my office today to schedule a confidential consultation to review the merits of your case.
        </p>
      </div>
      <div>
        <div class="flex flex-col gap-2.5 sm:flex-row lg:flex-col xl:flex-row">
          <a href={cta.href} class="btn btn-hi">{cta.label}</a>
          <ChatButton variant="line-deep" />
        </div>
        <p class="mt-4 text-sm text-deep-muted">All communications are strictly confidential.</p>
      </div>
    </div>
  </div>
</section>
