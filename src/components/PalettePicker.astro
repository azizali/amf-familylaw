---
const palettes = [
  { id: 'forest', name: 'Forest', deep: '#0f2a22', hi: '#c8f169' },
  { id: 'ocean', name: 'Ocean', deep: '#0c2a43', hi: '#7fd6ff' },
  { id: 'navy', name: 'Navy', deep: '#0e1b3a', hi: '#9db8ff' },
  { id: 'teal', name: 'Teal', deep: '#06302f', hi: '#5eead4' },
  { id: 'plum', name: 'Plum', deep: '#2a1638', hi: '#e8b4ff' },
  { id: 'crimson', name: 'Crimson', deep: '#2b0f14', hi: '#ff9aa2' },
  { id: 'terracotta', name: 'Terracotta', deep: '#2b1d2e', hi: '#f2a65a' },
  { id: 'gold', name: 'Slate & Gold', deep: '#1c2430', hi: '#e3b95b' },
  { id: 'graphite', name: 'Graphite', deep: '#151515', hi: '#f2f2f2' },
  { id: 'midnight', name: 'Midnight (dark)', deep: '#070914', hi: '#ff7a59' },
];
---
<div class="pal fixed bottom-[5.25rem] left-3 z-50 sm:bottom-4 sm:left-4">
  <div id="pal-panel" hidden class="absolute bottom-full left-0 mb-2 w-[17.5rem] rounded-2xl border border-line bg-card p-4 text-fg shadow-[0_18px_40px_-12px_rgb(0_0_0/0.45)]" role="group" aria-label="Color palette">
    <p class="tab-label text-accent-text">Color palette <span id="palette-name" class="ml-1 font-normal normal-case tracking-normal text-muted"></span></p>
    <div class="mt-3 grid grid-cols-5 gap-2.5">
      {palettes.map((p) => (
        <button type="button" data-palette-btn={p.id} data-name={p.name} aria-label={p.name} title={p.name} aria-pressed="false" class="pal-btn size-10 cursor-pointer rounded-full border border-black/15 transition-transform hover:scale-110" style={`background:linear-gradient(135deg,${p.deep} 50%,${p.hi} 50%)`}></button>
      ))}
    </div>
  </div>
  <button type="button" id="pal-toggle" aria-expanded="false" aria-controls="pal-panel" aria-label="Change color palette" class="flex size-12 cursor-pointer items-center justify-center rounded-full border border-line bg-card text-fg shadow-[0_8px_24px_-8px_rgb(0_0_0/0.4)] transition-transform hover:scale-105">
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 100 18c1.1 0 1.8-.9 1.5-1.9-.3-1 .4-2.1 1.5-2.1H17a4 4 0 004-4c0-5-4-10-9-10z"/><circle cx="7.5" cy="11" r="1" fill="currentColor"/><circle cx="10" cy="7" r="1" fill="currentColor"/><circle cx="15" cy="7.5" r="1" fill="currentColor"/></svg>
  </button>
</div>
<style>
  .pal-btn[aria-pressed="true"] { outline: 2px solid var(--fg); outline-offset: 3px; }
</style>
<script is:inline>
  (function () {
    var btns = document.querySelectorAll('[data-palette-btn]');
    var label = document.getElementById('palette-name');
    var panel = document.getElementById('pal-panel');
    var toggle = document.getElementById('pal-toggle');
    function mark() {
      var cur = document.documentElement.dataset.palette || 'forest';
      btns.forEach(function (b) {
        var on = b.dataset.paletteBtn === cur;
        b.setAttribute('aria-pressed', String(on));
        if (on && label) label.textContent = b.dataset.name;
      });
    }
    function open(v) { panel.hidden = !v; toggle.setAttribute('aria-expanded', String(v)); }
    toggle.addEventListener('click', function () { open(panel.hidden); });
    document.addEventListener('click', function (e) { if (!panel.hidden && !e.target.closest('.pal')) open(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) { open(false); toggle.focus(); } });
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        document.documentElement.dataset.palette = b.dataset.paletteBtn;
        try { localStorage.setItem('amf-palette', b.dataset.paletteBtn); } catch (e) {}
        mark();
      });
    });
    mark();
  })();
</script>
