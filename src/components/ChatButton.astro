---
import { chat } from '../data/site';
export interface Props { variant?: 'hi' | 'line-deep' | 'accent'; class?: string; }
const { variant = 'line-deep', class: cls = '' } = Astro.props;
---
{chat.enabled && (
  <button type="button" data-open-chat class:list={['btn', `btn-${variant}`, cls]}>
    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z" /></svg>
    {chat.label}
  </button>
)}
<script is:inline>
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-open-chat]');
    if (b) window.dispatchEvent(new CustomEvent('amf:open-chat'));
  });
</script>
