---
import AddressMap from './AddressMap.astro';
import { contact, firmLinks, firmName, offices, practiceLinks } from '../data/site';
---
<footer class="on-deep mt-6 bg-deep text-deep-muted">
  <div class="wrap grid gap-12 py-12 sm:grid-cols-2 lg:grid-cols-[1.1fr_1.1fr_0.9fr_1.4fr] lg:gap-10">
    <div>
      <a href="/" class="flex items-center gap-3" aria-label={firmName}>
        <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-hi font-serif text-sm font-semibold text-on-hi">AMF</span>
        <span class="text-sm font-semibold leading-tight text-on-deep">{firmName}</span>
      </a>
      <p class="mt-6 max-w-xs text-[0.95rem] leading-relaxed">
        Dedicated to bringing clarity, objectivity, and specialized expertise to your family law appeal.
      </p>
    </div>

    <div>
      <h4 class="tab-label text-hi">Practice Areas</h4>
      <ul class="mt-5 space-y-1 text-[0.95rem]">
        {practiceLinks.map((link) => (
          <li><a href={link.href} class="inline-block py-1 transition-colors hover:text-on-deep">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="tab-label text-hi">Firm</h4>
      <ul class="mt-5 space-y-1 text-[0.95rem]">
        {firmLinks.map((link) => (
          <li><a href={link.href} class="inline-block py-1 transition-colors hover:text-on-deep">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="tab-label text-hi">Contact</h4>
      <address class="mt-5 flex flex-col text-[0.95rem] not-italic">
        <a href={contact.phone.href} class="inline-block py-1 font-serif text-xl text-on-deep transition-colors hover:text-hi">{contact.phone.display}</a>
        <a href={contact.mapsHref} class="mt-3 leading-relaxed transition-colors hover:text-on-deep">
          {contact.address.lines[0]}<br />
          {contact.address.lines[1]}
        </a>
        <AddressMap query={offices[0].query} embedSrc={offices[0].embedSrc} title={offices[0].name} class="mt-4 !border-deep-line" />
      </address>
    </div>
  </div>
  <div class="border-t border-deep-line">
    <div class="wrap flex flex-col gap-4 py-8 text-sm md:flex-row md:items-start md:justify-between">
      <p class="shrink-0">&copy; {new Date().getFullYear()} {firmName}. All Rights Reserved.</p>
      <p class="max-w-lg text-xs leading-relaxed md:text-right">
        The information on this website is for general information purposes only. Nothing on this site should be taken as legal advice for any individual case or situation.
      </p>
    </div>
  </div>

</footer>
