---
import { cta } from '../data/site';
const services = [
  {
    tag: 'Trial Errors',
    title: 'Appealing Unfavorable Judgments',
    description:
      'If the trial judge misapplied the law or abused their discretion, I conduct a microscopic review of your trial record to find reversible errors and craft persuasive appellate briefs to fight for a reversal.',
  },
  {
    tag: 'Trial Success',
    title: 'Defending Your Trial Victory',
    description:
      "When the opposing party appeals a judgment that went in your favor, I develop the arguments to confirm the trial court's decision, dismantling the appellant's arguments so your victory stands.",
  },
  {
    tag: 'Consulting',
    title: 'Advising Trial Counsel',
    description:
      'I am consulted by trial attorneys before a final judgment is entered, ensuring the record is properly preserved for a future appeal, and documenting when the trial court makes a critical procedural error.',
  },
  {
    tag: 'Family Law',
    title: 'High-Stakes Parenting & Relocation Issues',
    description:
      'Navigating and appealing decisions where the court improperly evaluated the best interests of the child.',
  },
  {
    tag: 'Financials',
    title: 'Complex Property Division',
    description:
      'Challenging mischaracterizations of nonmarital versus marital property, erroneous business valuations, and the improper ruling regarding the tracing of financial assets.',
  },
  {
    tag: 'Support',
    title: 'Maintenance & Child Support',
    description:
      'Appealing judgments where the court failed to properly calculate income, ignored statutory factors, or awarded unjustifiably high or low support.',
  },
];
---
<section id="services" class="py-16 sm:py-20">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="chip">My Services</p>
      <h2 class="mt-4 text-[clamp(1.6rem,3vw,2.25rem)] leading-tight">What I Can Do For You</h2>
      <p class="mt-3 text-muted">
        Appellate law is a distinct discipline. Whether you are seeking to overturn an unfair judgment or defending a hard-won victory, I provide the specialized expertise needed at the appellate level.
      </p>
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
      {services.map((service, i) => (
        <article data-reveal style={`--i:${i % 3}`} class:list={['group r flex flex-col justify-between gap-6 border p-6 transition-all duration-300 hover:-translate-y-1', i === 0 ? 'bg-accent text-on-accent border-transparent lg:col-span-4' : i === 3 ? 'bg-deep text-on-deep border-transparent lg:col-span-4' : 'bg-card border-line', i < 4 ? 'lg:col-span-2' : 'lg:col-span-3']}>
          <p class:list={['tab-label', i === 0 ? 'opacity-80' : i === 3 ? 'text-hi' : 'text-accent-text']}>{service.tag}</p>
          <div>
            <h3 class="text-xl leading-snug">{service.title}</h3>
            <p class:list={['mt-2 text-sm leading-relaxed', i === 0 ? 'opacity-90' : i === 3 ? 'text-deep-muted' : 'text-muted']}>{service.description}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-8"><a href={cta.href} class="btn btn-accent">{cta.label}</a></div>
  </div>
</section>
