---
---
<section class="relative bg-slate-950 text-white overflow-hidden py-24 sm:py-32 border-b border-slate-800">
  <!-- Elegant Pattern Background -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-slate-950 mask-[linear-gradient(to_bottom,white,transparent)]"></div>
    <svg class="absolute inset-0 h-full w-full stroke-white/5 opacity-50" aria-hidden="true">
      <defs>
        <pattern id="hero-pattern" width="100" height="100" x="50%" y="-1" patternUnits="userSpaceOnUse">
          <path d="M.5 100V.5H100" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" stroke-width="0" fill="url(#hero-pattern)" />
    </svg>
    <!-- Soft Glow Effect -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-200 h-200 bg-sky-900/30 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center">
    
    <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-8 lg:mb-12 gap-10 sm:gap-12 lg:gap-12">
      <!-- Left Content -->
      <div class="max-w-3xl flex-1">
        <span class="inline-flex w-fit items-center rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 mb-8 text-xs font-semibold text-sky-300 transition-colors uppercase tracking-wider backdrop-blur-sm">
          You Have Options After a Bad Ruling
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight mb-8">
          When the Trial Judge Gets It Wrong, <span class="text-sky-200 font-medium italic">We Make It Right.</span>
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 max-w-2xl leading-relaxed font-light">
          Your family matters are too important to accept an unfair judgment. We meticulously analyze trial court records to find the critical errors needed to overturn wrongful decisions on appeal.
        </p>

        <div class="mt-10 flex gap-4">
          <a href="#get-started" class="inline-flex justify-center items-center rounded-lg bg-sky-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 transition-all border border-sky-500">
            Discuss your appeal
          </a>
          <a href="#services" class="inline-flex justify-center items-center rounded-lg border border-slate-700 bg-slate-800/50 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 transition-all backdrop-blur-sm">
            Learn More
          </a>
        </div>
      </div>

      <!-- Right Content: Attorney Image & Stats -->
      <div class="flex flex-col sm:flex-row lg:flex-col gap-4 shrink-0 w-full lg:w-96">
        <!-- Attorney Portrait -->
        <div class="relative overflow-hidden rounded-2xl border border-slate-700/50 shadow-2xl bg-slate-900/30 backdrop-blur-md">
          <img src="/annette-fernholz.jpg" alt="Appellate Attorney" class="w-full h-80 lg:h-90 object-cover transition-transform duration-300 hover:scale-105" />
          <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-slate-950/20 to-transparent"></div>
        </div>

        <div class="flex flex-col gap-4">
          <!-- Experience Statement -->
          <div class="bg-slate-900/50 backdrop-blur-md border border-slate-700/50 text-center p-4 sm:p-5 rounded-lg sm:rounded-xl shadow-lg">
            <p class="text-base sm:text-lg text-white font-medium">Appealing cases for more than three decades.</p>
          </div>
          
          <!-- Social Proof / Badge -->
          <div class="bg-linear-to-br from-slate-800/80 to-slate-900/80 backdrop-blur-md border border-slate-700/50 p-3 sm:p-4 rounded-lg sm:rounded-xl shadow-lg flex items-center gap-3">
            <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-full bg-sky-500/10 flex items-center justify-center shrink-0 border border-sky-400/30">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium text-sm sm:text-base mb-0.5">Recognized Excellence</p>
              <p class="text-xs text-slate-400 leading-snug">Top Rated Appellate Counsel & Selected to Super Lawyers</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
