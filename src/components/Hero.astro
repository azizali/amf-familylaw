---
import ChatButton from './ChatButton.astro';
import { cta } from '../data/site';
---
<section class="px-3 pt-3 sm:px-5">
  <div class="on-deep wrap relative !max-w-[72rem] overflow-hidden rounded-[2rem] bg-deep px-5 py-10 text-on-deep sm:px-10 sm:py-14 lg:px-14 lg:py-16" style="padding-left:clamp(1.25rem,4vw,3.5rem);padding-right:clamp(1.25rem,4vw,3.5rem)">
    <div class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full opacity-30 blur-3xl" style="background:var(--hi)" aria-hidden="true"></div>
    <div class="relative grid items-center gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-14">
      <div>
        <p class="rise chip" style="background:rgb(255 255 255 / 0.08);color:var(--hi)">You Have Options After a Bad Ruling</p>
        <h1 class="rise rise-2 mt-5 text-[clamp(1.9rem,4.4vw,3.25rem)] leading-[1.08]">
          When the Trial Judge Gets It Wrong, <span class="text-hi">We Make It Right.</span>
        </h1>
        <p class="rise rise-3 mt-5 max-w-[34rem] text-base leading-relaxed text-deep-muted sm:text-lg">
          Your family matters are too important to accept an unfair judgment. We meticulously analyze trial court records to find the critical errors needed to overturn wrongful decisions on appeal.
        </p>
        <div class="rise rise-3 mt-7 flex flex-col gap-2.5 sm:flex-row">
          <a href={cta.href} class="btn btn-hi">{cta.label}</a>
          <ChatButton variant="line-deep" />
          <a href="#services" class="btn btn-line-deep">Learn More</a>
        </div>
      </div>
      <div class="rise rise-2 mx-auto grid w-full max-w-sm grid-cols-2 gap-3 lg:max-w-none">
        <img src="/annette-fernholz.jpg" alt="Annette M. Fernholz, appellate attorney" width="960" height="960" fetchpriority="high" class="col-span-2 aspect-square w-full rounded-2xl object-cover object-top" />
        <div class="col-span-2 grid grid-cols-1 rounded-2xl border border-deep-line bg-white/5 sm:grid-cols-[1fr_auto_1fr]">
          <div class="flex items-start gap-3 p-4">
            <svg class="mt-0.5 size-5 shrink-0 text-hi" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M5 21h14M6 7h12M6 7l-3 7a3 3 0 0 0 6 0L6 7zM18 7l-3 7a3 3 0 0 0 6 0l-3-7z" /></svg>
            <p class="font-serif text-base leading-snug">Appealing cases for more than three decades.</p>
          </div>
          <span class="mx-4 my-0 h-px bg-deep-line sm:mx-0 sm:my-3 sm:h-auto sm:w-px" aria-hidden="true"></span>
          <div class="flex items-start gap-3 p-4">
            <svg class="mt-0.5 size-5 shrink-0 text-hi" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="6" /><path d="M8.5 14 7 22l5-3 5 3-1.5-8" /></svg>
            <div>
              <p class="font-serif text-base leading-snug">Recognized Excellence</p>
              <p class="mt-1 text-xs leading-snug text-deep-muted">Top Rated Appellate Counsel &amp; Selected to Super Lawyers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
