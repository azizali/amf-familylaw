---
export interface Props {
  title: string;
  crumbs?: { label: string; href?: string }[];
  meta?: string;
}
const { title, crumbs = [], meta } = Astro.props;
---
<section>
  <div class="on-deep relative overflow-hidden rounded-[2rem] bg-deep text-on-deep" style="padding:clamp(1.5rem,5vw,3.25rem)">
    <div class="pointer-events-none absolute -right-20 -top-24 size-72 rounded-full opacity-25 blur-3xl" style="background:var(--hi)" aria-hidden="true"></div>
    <div class="relative max-w-3xl">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-x-2 text-sm text-deep-muted">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="opacity-50">/</span>}
              {c.href ? <a href={c.href} class="hover:text-hi">{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <h1 class="text-[clamp(1.75rem,4vw,2.9rem)] leading-[1.1]">{title}</h1>
      {meta && <p class="mt-3 text-sm text-deep-muted">{meta}</p>}
    </div>
  </div>
</section>
