---
import { getCollection, render } from 'astro:content';
import CtaCard from '../components/CtaCard.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import { firmName, practiceLinks } from '../data/site';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  // The home page and blog index have their own routes, so their content is not rendered here.
  const reserved = new Set(['index', 'blog', 'about/testimonials']);
  const pages = await getCollection('pages', ({ id, data }) => !data.draft && !reserved.has(id));
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${entry.id}/`;
const section = entry.id.startsWith('practice') || entry.id.startsWith('chicago-same-sex') ? 'Practice Areas' : entry.id.startsWith('about') ? 'About' : null;
const sectionHref = section === 'Practice Areas' ? '/practice/' : section === 'About' ? '/about/' : undefined;
const crumbs = [{ label: 'Home', href: '/' }, ...(section && sectionHref !== path ? [{ label: section, href: sectionHref }] : []), { label: entry.data.title }];
---

<Layout title={`${entry.data.title} | ${firmName}`} description={entry.data.description || undefined}>
	<Header />
	<main id="main" class="wrap py-8 sm:py-10">
		<PageHeader title={entry.data.title} crumbs={crumbs} />
		<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_20rem] lg:items-start">
			<article class="prose-content r border border-line bg-card p-6 sm:p-10" style="max-width:none">
				<div style="max-width:68ch"><Content /></div>
			</article>
			<div class="space-y-4 lg:sticky lg:top-24">
				<CtaCard />
				<nav class="r border border-line bg-card p-5" aria-label="Practice areas">
					<h2 class="tab-label text-accent-text">Practice Areas</h2>
					<ul class="mt-3 space-y-0.5 text-sm">
						{practiceLinks.map((l) => (
							<li><a href={l.href} aria-current={l.href === path ? 'page' : undefined} class:list={['block rounded-lg px-2.5 py-2 transition-colors hover:bg-page', l.href === path && 'bg-page font-semibold text-accent-text']}>{l.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</div>
	</main>
</Layout>
