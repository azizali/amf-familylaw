---
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import { firmName } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
---

<Layout title={`Thank you | ${firmName}`}>
	<Header />
	<main id="main" class="wrap py-8 sm:py-10">
		<PageHeader title="Thank you. Your inquiry was received." crumbs={[{ label: 'Home', href: '/' }, { label: 'Connect with Annette' }]} />
		<div class="r mt-6 border border-line bg-card p-6 sm:p-10">
			<p class="max-w-xl text-muted">My office will review your message and contact you. Appellate deadlines are strict, and my office responds to every inquiry. If your matter is time-sensitive, the details you shared will help me prioritize.</p>
			<a href="/" class="btn btn-accent mt-6">Back to home</a>
		</div>
	</main>
</Layout>
